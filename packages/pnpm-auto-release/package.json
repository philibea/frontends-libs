{
  "name": "@phiphi/pnpm-auto-release",
  "version": "1.0.0",
  "private": true,
  "description": "Bump and publish changed packages via pnpm",
  "author": "Alexandre Philibeaux <alexandre@philibeaux.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philibea/frontends-libs.git",
    "directory": "packages/pnpm-auto-release"
  },
  "bin": {
    "pnpm-auto-release": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@phiphi/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=24.x"
  }
}
