{
  "name": "@phiphi/npm-trust",
  "version": "0.0.1",
  "private": true,
  "description": "Configure npm trusted publishers (GitHub Actions) for workspace packages",
  "author": "Alexandre Philibeaux <aphilibeaux@scaleway.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philibea/frontends-libs.git",
    "directory": "packages/npm-trust"
  },
  "bin": {
    "npm-trust": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
